---
import SiteLayout from '../layouts/SiteLayout.astro';
---

<SiteLayout title="Contact | Liew CheonFong" description="Send Liew CheonFong a message." canonicalPath="/contact/">
	<section class="contact-page" aria-labelledby="contact-title">
		<h1 id="contact-title">Get in touch</h1>
		<p class="lede">Send a message here or email <a href="mailto:liewcf@gmail.com">liewcf@gmail.com</a>.</p>
		<form id="contact-form" action="/api/contact" method="post">
			<label for="contact-email">Your email</label>
			<input id="contact-email" name="email" type="email" autocomplete="email" maxlength="254" required>
			<label for="contact-message">Message</label>
			<textarea id="contact-message" name="message" rows="5" maxlength="5000" required></textarea>
			<div id="contact-check"></div>
			<button type="submit" disabled>Send message</button>
			<p role="status" aria-live="polite"></p>
			<noscript><p>To send a message without JavaScript, use the email link above.</p></noscript>
		</form>
	</section>
	<script is:inline src="/contact.js" defer></script>
</SiteLayout>
