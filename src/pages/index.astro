---
import SiteLayout from '../layouts/SiteLayout.astro';
import UpdateTimeline from '../components/UpdateTimeline.astro';
import { getPublishedUpdates } from '../lib/updates';

import ProjectCard from '../components/ProjectCard.astro';
import ProjectFilter from '../components/ProjectFilter.astro';
import {
	getProjectCategories,
	getProjectSlug,
	getPublishedFeaturedProjects,
} from '../lib/projects';

const latestUpdates = (await getPublishedUpdates()).slice(0, 2);
const structuredData = {
	'@context': 'https://schema.org',
	'@graph': [
		{
			'@type': 'Person',
			'@id': 'https://liewcf.org/#person',
			name: 'Liew CheonFong',
			url: 'https://liewcf.org/',
			image: 'https://liewcf.org/assets/liewcf-profile.jpg',
			email: 'mailto:liewcf@gmail.com',
			sameAs: [
				'https://github.com/liewcf',
				'https://www.facebook.com/LiewCheonFong',
			],
			knowsAbout: ['WordPress', 'Developer utilities', 'Practical websites', 'SEO', 'Web development'],
		},
		{
			'@type': 'WebSite',
			'@id': 'https://liewcf.org/#website',
			url: 'https://liewcf.org/',
			name: 'Liew CheonFong',
			publisher: { '@id': 'https://liewcf.org/#person' },
			inLanguage: 'en',
		},
	],
};
const featuredProjects = await getPublishedFeaturedProjects();
const featuredCategories = getProjectCategories(featuredProjects);
const featuredProjectData = featuredProjects.map((project) => {
	const slug = getProjectSlug(project);

	return {
		name: project.data.title,
		description: project.data.summary,
		categories: project.data.categories,
		url: project.data.repositoryUrl,
		detailUrl: new URL(`/projects/${slug}/`, Astro.site).href,
	};
});
---

<SiteLayout
	title="Liew CheonFong | WordPress Tools, Developer Utilities, and Practical Websites"
	description="Liew CheonFong builds practical WordPress tools, developer utilities, and focused websites that make repeated work easier."
	ogTitle="Liew CheonFong"
	socialDescription="Practical WordPress tools, developer utilities, and focused websites that make repeated work easier."
	structuredData={structuredData}
>
			<section class="hero" aria-labelledby="intro-title">
				<div class="hero-copy">
					<h1 id="intro-title">Hello, I'm Liew CheonFong</h1>
					<p class="lede">
						I build WordPress plugins, browser extensions, macOS utilities, and focused websites that make everyday work simpler.
					</p>
					<nav class="profile-links" aria-label="Profile links">
						<a href="&#109;&#97;&#105;&#108;&#116;&#111;&#58;&#108;&#105;&#101;&#119;&#99;&#102;&#64;&#103;&#109;&#97;&#105;&#108;&#46;&#99;&#111;&#109;" class="profile-link-primary">Email</a>
						<a href="https://github.com/liewcf" rel="me noopener noreferrer" target="_blank">GitHub</a>
						<a href="https://www.facebook.com/LiewCheonFong" rel="me noopener noreferrer" target="_blank">Facebook</a>
					</nav>
				</div>
				<figure class="hero-image">
					<picture>
						<source srcset="/assets/liewcf-profile.avif" type="image/avif">
						<source srcset="/assets/liewcf-profile.webp" type="image/webp">
						<img
							src="/assets/liewcf-profile.jpg"
							alt="Portrait of Liew CheonFong"
							width="864"
							height="864"
							fetchpriority="high"
							decoding="async"
						>
					</picture>
				</figure>
			</section>

			<section class="section" aria-labelledby="build-title">
				<div class="section-heading">
					<h2 id="build-title">Small tools for work that should feel easier.</h2>
				</div>
				<div class="focus-grid">
					<article class="focus-tile">
						<span class="tile-number" aria-hidden="true">01</span>
						<h3>WordPress tools for everyday site work.</h3>
						<p>EnjinMel SMTP connects WordPress email to the Enginemailer API, with delivery logs and test-email tools in the dashboard.</p>
					</article>
					<article class="focus-tile">
						<span class="tile-number" aria-hidden="true">02</span>
						<h3>Small utilities for your browser and Mac.</h3>
						<p>Clean up a YouTube Watch Later queue, enlarge an image, or track focused computer time with Auto-Tomato.</p>
					</article>
					<article class="focus-tile">
						<span class="tile-number" aria-hidden="true">03</span>
						<h3>Clear websites and research tools.</h3>
						<p>Readable pages and tools that help people find what they need. Verified Person Research pairs professional background summaries with sources and clear limits.</p>
					</article>
				</div>
			</section>

			<section class="section projects" aria-labelledby="projects-title">
				<div class="section-heading">
					<h2 id="projects-title">Selected projects from my workbench.</h2>
					<p class="section-lede">Browser utilities, a WordPress plugin, and a research skill. Explore what each does and how it works.</p>
					<p class="section-lede"><a href="/projects/">Browse all projects</a></p>
				</div>
				<div class="projects-column">
					<ProjectFilter categories={featuredCategories} />
					<div class="project-grid" id="project-grid">
						{featuredProjects.map((project) => <ProjectCard project={project} />)}
					</div>
				</div>
			</section>

			{latestUpdates.length > 0 && (
				<section class="section" aria-labelledby="latest-updates-title">
					<div class="section-heading">
						<h2 id="latest-updates-title">Latest project updates.</h2>
						<p class="section-lede">Release notes and verification milestones, with their limitations.</p>
					</div>
					<div>
						<UpdateTimeline updates={latestUpdates} emptyMessage="" />
						<p class="section-lede"><a href="/updates/">All updates</a> · <a href="/updates/rss.xml">Subscribe via RSS</a></p>
					</div>
				</section>
			)}
			<script is:inline define:vars={{ featuredProjects: featuredProjectData }}>
		(() => {
			const revealTargets = document.querySelectorAll(
				'.hero-copy, .hero-image, .focus-tile',
			);

			if (!('IntersectionObserver' in window)) {
				revealTargets.forEach((el) => el.classList.add('is-revealed'));
			} else {
				const revealObserver = new IntersectionObserver(
					(entries, observer) => {
						entries.forEach((entry) => {
							if (entry.isIntersecting) {
								entry.target.classList.add('is-revealed');
								observer.unobserve(entry.target);
							}
						});
					},
					{ threshold: 0.08, rootMargin: '0px 0px -40px 0px' },
				);
				revealTargets.forEach((el) => revealObserver.observe(el));
			}

			if (!('modelContext' in navigator) || !navigator.modelContext?.provideContext) {
				return;
			}

			navigator.modelContext.provideContext({
				tools: [
					{
						name: 'get_profile_summary',
						description: 'Return a concise summary of Liew CheonFong from the static profile homepage.',
						inputSchema: {
							type: 'object',
							properties: {},
							additionalProperties: false,
						},
						execute: async () => ({
							name: 'Liew CheonFong',
							url: 'https://liewcf.org/',
							summary: 'Liew CheonFong builds small, durable tools for WordPress, web workflows, developer utilities, and everyday development work.',
							focusAreas: ['WordPress tools', 'Developer utilities', 'Practical web experiences'],
						}),
					},
					{
						name: 'list_featured_projects',
						description: 'Return the featured GitHub projects listed on the homepage.',
						inputSchema: {
							type: 'object',
							properties: {},
							additionalProperties: false,
						},
						execute: async () => ({ projects: featuredProjects }),
					},
					{
						name: 'get_contact_links',
						description: 'Return public contact and profile links from the homepage.',
						inputSchema: {
							type: 'object',
							properties: {},
							additionalProperties: false,
						},
						execute: async () => ({
							links: [
								{ label: 'Email', url: 'mailto:liewcf@gmail.com' },
								{ label: 'GitHub', url: 'https://github.com/liewcf' },
								{ label: 'Facebook', url: 'https://www.facebook.com/LiewCheonFong' },
							],
						}),
					},
				],
			});
			})();
			</script>
</SiteLayout>
