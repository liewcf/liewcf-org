---
import SiteLayout from '../layouts/SiteLayout.astro';

const structuredData = {
	'@context': 'https://schema.org',
	'@graph': [
		{
			'@type': 'Person',
			'@id': 'https://liewcf.org/#person',
			name: 'Liew CheonFong',
			url: 'https://liewcf.org/',
			image: 'https://liewcf.org/assets/liewcf-profile.jpg',
			email: 'mailto:liewcf@gmail.com',
			sameAs: [
				'https://github.com/liewcf',
				'https://www.facebook.com/LiewCheonFong',
			],
			knowsAbout: ['WordPress', 'Developer utilities', 'Practical websites', 'SEO', 'Web development'],
		},
		{
			'@type': 'WebSite',
			'@id': 'https://liewcf.org/#website',
			url: 'https://liewcf.org/',
			name: 'Liew CheonFong',
			publisher: { '@id': 'https://liewcf.org/#person' },
			inLanguage: 'en',
		},
	],
};
---

<SiteLayout
	title="Liew CheonFong | WordPress Tools, Developer Utilities, and Practical Websites"
	description="Liew CheonFong builds practical WordPress tools, developer utilities, and focused websites that make repeated work easier."
	ogTitle="Liew CheonFong"
	socialDescription="Practical WordPress tools, developer utilities, and focused websites that make repeated work easier."
	structuredData={structuredData}
>
			<section class="hero" aria-labelledby="intro-title">
				<div class="hero-copy">
					<h1 id="intro-title">Hello, I'm Liew CheonFong</h1>
					<p class="lede">
						I build WordPress plugins, macOS utilities, and focused websites — the kind of tools that make the next time faster than the first.
					</p>
					<nav class="profile-links" aria-label="Profile links">
						<a href="&#109;&#97;&#105;&#108;&#116;&#111;&#58;&#108;&#105;&#101;&#119;&#99;&#102;&#64;&#103;&#109;&#97;&#105;&#108;&#46;&#99;&#111;&#109;" class="profile-link-primary">Email</a>
						<a href="https://github.com/liewcf" rel="me noopener noreferrer" target="_blank">GitHub</a>
						<a href="https://www.facebook.com/LiewCheonFong" rel="me noopener noreferrer" target="_blank">Facebook</a>
					</nav>
				</div>
				<figure class="hero-image">
					<picture>
						<source srcset="/assets/liewcf-profile.avif" type="image/avif">
						<source srcset="/assets/liewcf-profile.webp" type="image/webp">
						<img
							src="/assets/liewcf-profile.jpg"
							alt="Portrait of Liew CheonFong"
							width="864"
							height="864"
							fetchpriority="high"
							decoding="async"
						>
					</picture>
				</figure>
			</section>

			<section class="section" aria-labelledby="build-title">
				<div class="section-heading">
					<h2 id="build-title">Small tools for work that should feel easier.</h2>
				</div>
				<div class="focus-grid">
					<article class="focus-tile">
						<span class="tile-number" aria-hidden="true">01</span>
						<h3>WordPress plugins that stay out of the way.</h3>
						<p>Routing email through reliable APIs. Generating secure draft preview links. Solving the small WordPress problems that come up on every site, once, properly.</p>
					</article>
					<article class="focus-tile">
						<span class="tile-number" aria-hidden="true">02</span>
						<h3>macOS utilities built for the menu bar.</h3>
						<p>Lightweight apps that live quietly in the menu bar and do one thing without a Dock icon, a preferences window, or a subscription.</p>
					</article>
					<article class="focus-tile">
						<span class="tile-number" aria-hidden="true">03</span>
						<h3>Focused websites that explain the useful thing.</h3>
						<p>Pages that load fast, read clearly, and don't need a CMS to maintain. Built to be handed off without a training session.</p>
					</article>
				</div>
			</section>

			<section class="section projects" aria-labelledby="projects-title">
				<div class="section-heading">
					<h2 id="projects-title">A few shipped tools from my workbench.</h2>
					<p class="section-lede">Four repositories I keep coming back to. Each solves a problem I ran into more than once.</p>
				</div>
				<div class="projects-column">
					<div class="filter-bar" role="group" aria-label="Filter projects by category">
						<button class="filter-btn active" type="button" data-filter="all" aria-pressed="true">All</button>
						<button class="filter-btn" type="button" data-filter="WordPress" aria-pressed="false">WordPress</button>
						<button class="filter-btn" type="button" data-filter="Chrome Extension" aria-pressed="false">Chrome Extension</button>
						<button class="filter-btn" type="button" data-filter="Developer Tool" aria-pressed="false">Developer Tool</button>
					</div>
					<p class="filter-status" role="status" aria-live="polite" aria-atomic="true"></p>
					<div class="project-grid" id="project-grid">
						<article class="project-card" data-tags="Chrome Extension,JavaScript,YouTube">
							<div class="project-card-body">
								<p class="project-repo">liewcf/youtube-watchlist-manager</p>
								<h3>youtube-watchlist-manager</h3>
								<p>A Chrome extension that speeds up YouTube Watch Later cleanup with checkboxes, batch removal, and watched-first sorting.</p>
							</div>
							<ul class="project-tags" role="list" aria-label="Project categories">
								<li>Chrome Extension</li>
								<li>JavaScript</li>
								<li>YouTube</li>
							</ul>
							<div class="project-links">
								<a href="https://github.com/liewcf/youtube-watchlist-manager" rel="noopener noreferrer" target="_blank" aria-label="View youtube-watchlist-manager on GitHub" class="project-link-primary">View on GitHub</a>
							</div>
						</article>
						<article class="project-card" data-tags="WordPress,Email,Plugin">
							<div class="project-card-body">
								<p class="project-repo">liewcf/enjinmel-smtp</p>
								<h3>enjinmel-smtp</h3>
								<p>A WordPress plugin that routes site email through the Enginemailer REST API for more reliable delivery.</p>
							</div>
							<ul class="project-tags" role="list" aria-label="Project categories">
								<li>WordPress</li>
								<li>Email</li>
								<li>Plugin</li>
							</ul>
							<div class="project-links">
								<a href="https://github.com/liewcf/enjinmel-smtp" rel="noopener noreferrer" target="_blank" aria-label="View enjinmel-smtp on GitHub" class="project-link-primary">View on GitHub</a>
							</div>
						</article>
						<article class="project-card" data-tags="Codex,Developer Tool,Research">
							<div class="project-card-body">
								<p class="project-repo">liewcf/verified-person-research</p>
								<h3>verified-person-research</h3>
								<p>A Codex skill that turns a LinkedIn profile into a cited life story, timeline, confidence table, and source list without inventing missing facts.</p>
							</div>
							<ul class="project-tags" role="list" aria-label="Project categories">
								<li>Codex</li>
								<li>Developer Tool</li>
								<li>Research</li>
							</ul>
							<div class="project-links">
								<a href="https://github.com/liewcf/verified-person-research" rel="noopener noreferrer" target="_blank" aria-label="View verified-person-research on GitHub" class="project-link-primary">View on GitHub</a>
							</div>
						</article>
						<article class="project-card" data-tags="Chrome Extension,JavaScript,Utility">
							<div class="project-card-body">
								<p class="project-repo">liewcf/imagezoom</p>
								<h3>imagezoom</h3>
								<p>A small Chrome extension for zooming images on web pages.</p>
							</div>
							<ul class="project-tags" role="list" aria-label="Project categories">
								<li>Chrome Extension</li>
								<li>JavaScript</li>
								<li>Utility</li>
							</ul>
							<div class="project-links">
								<a href="https://github.com/liewcf/imagezoom" rel="noopener noreferrer" target="_blank" aria-label="View imagezoom on GitHub" class="project-link-primary">View on GitHub</a>
							</div>
						</article>
					</div>
				</div>
			</section>

			<section class="section proof" aria-labelledby="proof-title">
				<div class="section-heading">
					<h2 id="proof-title">The work I keep coming back to.</h2>
				</div>
				<ul class="proof-list" role="list">
					<li>WordPress plugins — email routing, draft previews, WooCommerce tweaks — written to be installed and forgotten, not maintained.</li>
					<li>macOS menu bar utilities in Swift: small, focused, no Dock icon, no subscription. The tools I wished existed before I built them.</li>
					<li>Websites and landing pages built for longevity — fast to load, easy to hand off, and still working correctly two years later.</li>
				</ul>
			</section>
			<script is:inline>
		(() => {
			const filterButtons = document.querySelectorAll('.filter-btn');
			const projectCards = document.querySelectorAll('.project-card');
			const filterStatus = document.querySelector('.filter-status');

			const setProjectFilter = (filter) => {
				let visible = 0;

				filterButtons.forEach((button) => {
					const isActive = button.dataset.filter === filter;
					button.classList.toggle('active', isActive);
					button.setAttribute('aria-pressed', String(isActive));
				});

				projectCards.forEach((card) => {
					const tags = (card.dataset.tags || '').split(',').map((tag) => tag.trim());
					const shouldShow = filter === 'all' || tags.includes(filter);
					card.hidden = !shouldShow;
					if (shouldShow) {
						visible += 1;
					}
				});

				if (filterStatus) {
					filterStatus.textContent = filter === 'all'
						? ''
						: `${visible} project${visible === 1 ? '' : 's'} in ${filter}`;
				}
			};

			filterButtons.forEach((button) => {
				button.addEventListener('click', () => setProjectFilter(button.dataset.filter || 'all'));
			});

			const revealTargets = document.querySelectorAll(
				'.hero-copy, .hero-image, .focus-tile, .project-card, .proof-list li',
			);

			if (!('IntersectionObserver' in window)) {
				revealTargets.forEach((el) => el.classList.add('is-revealed'));
			} else {
				const revealObserver = new IntersectionObserver(
					(entries, observer) => {
						entries.forEach((entry) => {
							if (entry.isIntersecting) {
								entry.target.classList.add('is-revealed');
								observer.unobserve(entry.target);
							}
						});
					},
					{ threshold: 0.08, rootMargin: '0px 0px -40px 0px' },
				);
				revealTargets.forEach((el) => revealObserver.observe(el));
			}

			if (!('modelContext' in navigator) || !navigator.modelContext?.provideContext) {
				return;
			}

			const featuredProjects = [
				{
					name: 'youtube-watchlist-manager',
					description: 'A Chrome extension that speeds up YouTube Watch Later cleanup with checkboxes, batch removal, and watched-first sorting.',
					url: 'https://github.com/liewcf/youtube-watchlist-manager',
				},
				{
					name: 'enjinmel-smtp',
					description: 'A WordPress plugin that routes site email through the Enginemailer REST API for more reliable delivery.',
					url: 'https://github.com/liewcf/enjinmel-smtp',
				},
				{
					name: 'verified-person-research',
					description: 'A Codex skill that turns a LinkedIn profile into a cited life story, timeline, confidence table, and source list without inventing missing facts.',
					url: 'https://github.com/liewcf/verified-person-research',
				},
				{
					name: 'imagezoom',
					description: 'A small Chrome extension for zooming images on web pages.',
					url: 'https://github.com/liewcf/imagezoom',
				},
			];

			navigator.modelContext.provideContext({
				tools: [
					{
						name: 'get_profile_summary',
						description: 'Return a concise summary of Liew CheonFong from the static profile homepage.',
						inputSchema: {
							type: 'object',
							properties: {},
							additionalProperties: false,
						},
						execute: async () => ({
							name: 'Liew CheonFong',
							url: 'https://liewcf.org/',
							summary: 'Liew CheonFong builds small, durable tools for WordPress, web workflows, developer utilities, and everyday development work.',
							focusAreas: ['WordPress tools', 'Developer utilities', 'Practical web experiences'],
						}),
					},
					{
						name: 'list_featured_projects',
						description: 'Return the featured GitHub projects listed on the homepage.',
						inputSchema: {
							type: 'object',
							properties: {},
							additionalProperties: false,
						},
						execute: async () => ({ projects: featuredProjects }),
					},
					{
						name: 'get_contact_links',
						description: 'Return public contact and profile links from the homepage.',
						inputSchema: {
							type: 'object',
							properties: {},
							additionalProperties: false,
						},
						execute: async () => ({
							links: [
								{ label: 'Email', url: 'mailto:liewcf@gmail.com' },
								{ label: 'GitHub', url: 'https://github.com/liewcf' },
								{ label: 'Facebook', url: 'https://www.facebook.com/LiewCheonFong' },
							],
						}),
					},
				],
			});
			})();
			</script>
</SiteLayout>
